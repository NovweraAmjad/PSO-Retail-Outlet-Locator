# Backend deployment environment variables
# Comma-separated list of allowed frontend origins.
# Example: https://pso-locator-frontend.onrender.com
ALLOWED_ORIGINS=https://your-frontend-domain.onrender.com

# Keep false unless you use cookie-based auth.
CORS_ALLOW_CREDENTIALS=false

# Optional: override DB path (useful if mounting a persistent disk on cloud).
# PSO_DB_FILE=/var/data/pso_outlets.db
